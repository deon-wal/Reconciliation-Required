        // Navigation Switching Engine
        function showSection(sectionId) {
            const sections = ['hero', 'story', 'characters', 'atlas', 'dossier', 'calculator', 'codex'];
            sections.forEach(s => {
                const el = document.getElementById(`section-${s}`);
                if (el) el.classList.add('hidden');
                const navBtn = document.getElementById(`nav-${s}`);
                if (navBtn) navBtn.classList.remove('text-ochre-desert', 'border-b-2', 'border-ochre-desert');
            });

            const targetSection = document.getElementById(`section-${sectionId}`);
            if (targetSection) targetSection.classList.remove('hidden');
            
            const activeNav = document.getElementById(`nav-${sectionId}`);
            if (activeNav) activeNav.classList.add('text-ochre-desert', 'border-b-2', 'border-ochre-desert');

            if (sectionId === 'dossier') {
                loadCase(1);
            } else if (sectionId === 'atlas') {
                renderAtlasNav();
                loadAtlasMap(1);
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Render Atlas Map Selector Nav
        function renderAtlasNav() {
            const container = document.getElementById('map-nav-container');
            if (!container) return;
            container.innerHTML = '';

            for (let id = 1; id <= 8; id++) {
                const m = atlasMapData[id];
                const btn = document.createElement('button');
                btn.id = `atlas-map-btn-${id}`;
                btn.className = `w-full text-left px-3 py-2 rounded transition-all flex items-center justify-between ${id === 1 ? 'bg-ochre-desert/20 border border-ochre-desert text-ochre-desert font-bold' : 'bg-basalt-900/60 border border-basalt-700 text-chalk/70 hover:text-ochre-desert hover:border-basalt-600'}`;
                btn.onclick = () => loadAtlasMap(id);
                btn.innerHTML = `
                    <span class="truncate pr-2">${m.title}</span>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 shrink-0 opacity-50"></i>
                `;
                container.appendChild(btn);
            }
            lucide.createIcons();
        }

        // Load Specific Map into Viewport
        function loadAtlasMap(id) {
            const m = atlasMapData[id];
            if (!m) return;

            // Highlight nav button
            for (let i = 1; i <= 8; i++) {
                const b = document.getElementById(`atlas-map-btn-${i}`);
                if (b) {
                    b.className = `w-full text-left px-3 py-2 rounded transition-all flex items-center justify-between ${i === id ? 'bg-ochre-desert/20 border border-ochre-desert text-ochre-desert font-bold' : 'bg-basalt-900/60 border border-basalt-700 text-chalk/70 hover:text-ochre-desert hover:border-basalt-600'}`;
                }
            }

            // Update Header Display
            document.getElementById('map-code-display').innerText = m.code;
            document.getElementById('map-title-display').innerText = m.title;
            document.getElementById('map-coords').innerText = m.coords;

            // Load SVG content
            document.getElementById('svg-map-viewport').innerHTML = m.svg;

            // Reset Inspector
            document.getElementById('inspector-name').innerText = "CLICK A MAP MARKER TO AUDIT LOCATION";
            document.getElementById('inspector-sector').innerText = "CIVIC SECTOR: UNBOUND";
            document.getElementById('inspector-desc').innerText = "Select any yellow or teal beacon on the municipal blueprint to reveal classified civil planning notes, environmental anomalies, or narrative links.";

            lucide.createIcons();
        }

        // Inspect Specific Marker
        function inspectAtlasMarker(name, sector, desc, actLink) {
            document.getElementById('inspector-name').innerText = name;
            document.getElementById('inspector-sector').innerText = `SECTOR: ${sector}`;
            document.getElementById('inspector-desc').innerHTML = `
                ${desc}
                <br/><button onclick="showSection('story'); scrollToAct('act-${actLink}');" class="mt-2 inline-flex items-center space-x-1 text-ochre-desert hover:underline font-mono text-[11px]">
                    <span>GOTO STORY ARCHIVE ACT ${actLink}</span>
                    <i data-lucide="arrow-right" class="w-3 h-3"></i>
                </button>
            `;
            lucide.createIcons();
        }

        // Layer Toggle (Surface vs. Undercity)
        function toggleMapLayer(layer) {
            const btnSurface = document.getElementById('btn-layer-surface');
            const btnUnder = document.getElementById('btn-layer-undercity');

            if (layer === 'surface') {
                btnSurface.className = "px-2.5 py-1 rounded bg-ochre-desert text-basalt-900 font-bold uppercase transition-all";
                btnUnder.className = "px-2.5 py-1 rounded bg-basalt-700 text-chalk hover:text-ochre-desert uppercase transition-all";
                loadAtlasMap(1);
            } else {
                btnUnder.className = "px-2.5 py-1 rounded bg-ochre-desert text-basalt-900 font-bold uppercase transition-all";
                btnSurface.className = "px-2.5 py-1 rounded bg-basalt-700 text-chalk hover:text-ochre-desert uppercase transition-all";
                loadAtlasMap(6);
            }
        }

        function resetMapZoom() {
            const viewport = document.getElementById('svg-map-viewport');
            viewport.style.transform = "scale(1)";
        }

        // Character Modal Functions
        function openCharacterModal(charKey) {
            const data = characterData[charKey];
            if (!data) return;

            const modalContent = document.getElementById('character-modal-content');
            modalContent.innerHTML = `
                <div class="flex flex-col md:flex-row gap-6 items-start border-b border-basalt-700 pb-6">
                    <img src="${data.image}" alt="${data.name}" class="w-full md:w-48 h-64 object-cover rounded-sm border border-basalt-600">
                    <div class="space-y-3 flex-grow">
                        <span class="font-mono text-xs text-ochre-desert uppercase tracking-widest">${data.role}</span>
                        <h3 class="font-serif text-3xl text-chalk">${data.name}</h3>
                        <div class="inline-block px-2 py-1 bg-amber-alert/10 border border-amber-alert/30 font-mono text-xs text-amber-alert">
                            ${data.status}
                        </div>
                        <p class="font-sans text-xs sm:text-sm text-chalk/80 leading-relaxed pt-2">
                            ${data.bio}
                        </p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs">
                    <div class="bg-basalt-900 p-4 border border-basalt-700 space-y-1">
                        <span class="text-ochre-desert">EMOTIONAL &amp; NARRATIVE ARC:</span>
                        <p class="text-chalk/70 font-sans text-xs mt-1 leading-relaxed">${data.progression}</p>
                    </div>
                    <div class="bg-basalt-900 p-4 border border-basalt-700 space-y-1">
                        <span class="text-teal-glow">CORE MOTIVATION:</span>
                        <p class="text-chalk/70 font-sans text-xs mt-1 leading-relaxed">${data.motivation}</p>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row justify-between items-center gap-4 border-t border-basalt-700 pt-4 font-mono text-xs">
                    <div class="text-chalk/60">
                        <span>SIGNATURE ITEM:</span> <span class="text-chalk font-semibold">${data.signature}</span>
                    </div>
                    <button onclick="closeCharacterModal(); showSection('story'); scrollToAct('${data.actTarget}');" class="px-4 py-2 bg-ochre-desert text-basalt-900 font-bold hover:bg-ochre-light transition-all uppercase tracking-wider">
                        READ IN STORY ARCHIVE →
                    </button>
                </div>
            `;

            document.getElementById('character-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function closeCharacterModal() {
            document.getElementById('character-modal').classList.add('hidden');
        }

        // Scroll to specific Act in Story Archive
        function scrollToAct(actId) {
            const actElement = document.getElementById(actId);
            if (actElement) {
                actElement.scrollIntoView({ behavior: 'smooth' });
                updateActProgress(actId);
            }
        }

        function updateActProgress(activeActId) {
            for (let i = 1; i <= 4; i++) {
                const btn = document.getElementById(`act-btn-${i}`);
                if (btn) {
                    if (`act-${i}` === activeActId) {
                        btn.className = "px-2.5 py-1 rounded bg-basalt-700 text-ochre-desert font-bold transition-colors";
                    } else {
                        btn.className = "px-2.5 py-1 rounded bg-basalt-800 text-chalk/60 hover:text-ochre-desert transition-colors";
                    }
                }
            }
        }

        // Observer for scroll progress in Story Archive
        window.addEventListener('scroll', () => {
            const storySection = document.getElementById('section-story');
            if (storySection && !storySection.classList.contains('hidden')) {
                const acts = ['act-1', 'act-2', 'act-3', 'act-4'];
                for (let actId of acts) {
                    const el = document.getElementById(actId);
                    if (el) {
                        const rect = el.getBoundingClientRect();
                        if (rect.top <= 200 && rect.bottom >= 200) {
                            updateActProgress(actId);
                            break;
                        }
                    }
                }
            }
        });

        // Toggle Mobile Menu
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        document.getElementById('mobile-menu-btn').addEventListener('click', toggleMobileMenu);

        // Load Case Details into Dossier
        function loadCase(id) {
            const caseData = cases[id];
            if (!caseData) return;

            for (let i = 1; i <= 3; i++) {
                const btn = document.getElementById(`case-btn-${i}`);
                if (btn) {
                    btn.classList.remove('bg-basalt-800', 'border-ochre-desert/80');
                    btn.classList.add('bg-basalt-800/40', 'border-basalt-700');
                }
            }
            const selectedBtn = document.getElementById(`case-btn-${id}`);
            if (selectedBtn) {
                selectedBtn.classList.remove('bg-basalt-800/40', 'border-basalt-700');
                selectedBtn.classList.add('bg-basalt-800', 'border-ochre-desert/80');
            }

            const container = document.getElementById('case-detail-content');
            container.innerHTML = `
                <div class="border-b border-basalt-700 pb-4">
                    <div class="flex justify-between items-center font-mono text-xs text-ochre-desert">
                        <span>${caseData.date}</span>
                        <span class="px-2 py-0.5 bg-amber-alert/10 text-amber-alert border border-amber-alert/30">${caseData.status}</span>
                    </div>
                    <h3 class="font-serif text-2xl sm:text-3xl text-chalk mt-2">${caseData.title}</h3>
                </div>
                ${caseData.content}
            `;
        }

        // Relational Debt Calculator
        function calculateDebt() {
            const years = parseInt(document.getElementById('slider-years').value);
            const artifacts = parseInt(document.getElementById('slider-artifacts').value);
            const intensity = parseInt(document.getElementById('slider-intensity').value);
            const unspoken = document.getElementById('chk-unspoken').checked;
            const cohabitation = document.getElementById('chk-cohabitation').checked;

            document.getElementById('val-years').innerText = `${years} Years`;
            document.getElementById('val-artifacts').innerText = `${artifacts} Items`;
            document.getElementById('val-intensity').innerText = `${intensity}%`;

            let baseScore = (years * 1200) + (artifacts * 350) + (intensity * 250);
            if (unspoken) baseScore *= 1.15;
            if (cohabitation) baseScore *= 1.25;

            const finalScore = Math.round(baseScore);
            document.getElementById('debt-score').innerText = `${finalScore.toLocaleString()} CR`;

            const statusEl = document.getElementById('debt-status');
            const riskEl = document.getElementById('debt-risk');
            const periodEl = document.getElementById('debt-period');
            const actionEl = document.getElementById('debt-action');

            if (finalScore < 15000) {
                statusEl.innerHTML = `STATUS: <span class="text-teal-glow font-bold">ACCEPTABLE MARGIN</span>`;
                riskEl.innerText = "LOW";
                riskEl.className = "text-teal-glow";
                periodEl.innerText = "36 Months";
                actionEl.innerText = "ROUTINE AUDIT";
            } else if (finalScore < 35000) {
                statusEl.innerHTML = `STATUS: <span class="text-amber-alert font-bold">MODERATE IMPAIRMENT</span>`;
                riskEl.innerText = "ELEVATED";
                riskEl.className = "text-amber-alert";
                periodEl.innerText = "18 Months";
                actionEl.innerText = "MANDATORY SEPARATION";
            } else {
                statusEl.innerHTML = `STATUS: <span class="text-red-500 font-bold">CRITICAL DEFICIT</span>`;
                riskEl.innerText = "EXTREME";
                riskEl.className = "text-red-500";
                periodEl.innerText = "IMMEDIATE (72 HRS)";
                actionEl.innerText = "TOTAL AMORTIZATION";
            }
        }

        // Modal Functions
        function triggerPurgeModal() {
            document.getElementById('purge-modal').classList.remove('hidden');
        }

        function closePurgeModal() {
            document.getElementById('purge-modal').classList.add('hidden');
        }

        function executePurge() {
            alert("MUNICIPAL REQUEST REGISTERED. Scrubbing unit dispatched to your location.");
            closePurgeModal();
        }

        // Initialize Calculator
        calculateDebt();
    </script>
</body>
</html>
